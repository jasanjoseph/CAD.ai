# Copy to .env and fill in. .env is git-ignored.

# LLM used by the agent nodes: gemini | openai | anthropic
# gemini = free tier (rate-limited, no billing account needed)
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Get one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides
#GEMINI_MODEL=gemini-3.5-flash
#GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Only needed for the non-free providers ---
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_MODEL=gpt-4o
#ANTHROPIC_MODEL=claude-sonnet-5-5
#EMBEDDING_PROVIDER=openai
#EMBEDDING_MODEL=text-embedding-3-small
#RULEBOOK_DB_DIR=./.rulebook_chroma
#RULEBOOK_COLLECTION=baja_sae_rulebook
#REPORTS_DIR=./reports
